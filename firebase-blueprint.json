{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "email": { "type": "string", "description": "User email address from OAuth profile" },
        "displayName": { "type": "string", "description": "User full name from OAuth profile" },
        "photoURL": { "type": "string", "description": "User avatar profile image URL" },
        "createdAt": { "type": "timestamp", "description": "Account registration timestamp" },
        "lastLoginAt": { "type": "timestamp", "description": "Latest sign-in timestamp" },
        "settings": { "type": "map", "description": "User custom detection and alert preferences" }
      }
    },
    "ScanRecord": {
      "collection": "users/{userId}/scans",
      "fields": {
        "title": { "type": "string", "description": "Scan title or audio file name" },
        "confidence": { "type": "number", "description": "Synthetic or real confidence percentage" },
        "classification": { "type": "string", "description": "synthetic or authentic" },
        "modelDetected": { "type": "string", "description": "Estimated neural voice synthesis model or organic speech" },
        "fileSize": { "type": "string", "description": "Audio file size description" },
        "duration": { "type": "string", "description": "Audio duration in seconds" },
        "anomalies": { "type": "list", "description": "Detected forensic anomaly tags" },
        "timestamp": { "type": "timestamp", "description": "Scan analysis timestamp" }
      }
    },
    "TranscriptRecord": {
      "collection": "users/{userId}/transcripts",
      "fields": {
        "text": { "type": "string", "description": "Verbatim transcript generated by gemini-3.5-transcribe" },
        "model": { "type": "string", "description": "Gemini model used: gemini-3.5-transcribe" },
        "duration": { "type": "string", "description": "Duration of audio transcribed" },
        "wordCount": { "type": "number", "description": "Total word count in transcription" },
        "timestamp": { "type": "timestamp", "description": "Transcription creation timestamp" }
      }
    }
  }
}
